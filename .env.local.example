# Copia questo file in .env.local e inserisci i valori della tua app Firebase
# (Console Firebase → Impostazioni progetto → I tuoi app → App web)

NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tuo-progetto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://tuo-progetto-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tuo-progetto
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Percorso base per GitHub Pages. Vuoto in locale, /lineadeltempo nel build Pages.
NEXT_PUBLIC_BASE_PATH=

# Usata dallo script scripts/sync-images.mjs e dalla GitHub Action.
FIREBASE_DATABASE_URL=https://tuo-progetto-default-rtdb.europe-west1.firebasedatabase.app
